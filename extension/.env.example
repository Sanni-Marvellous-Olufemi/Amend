# Copy to .env.local (gitignored). scripts/gen-extension-key.sh fills in VITE_EXTENSION_KEY.

# Public key that pins the extension ID (not a secret, but generated per developer).
VITE_EXTENSION_KEY=

# OAuth client of type "Chrome Extension" (Google Cloud Console). Enables chrome.identity.getAuthToken.
VITE_GOOGLE_CLIENT_ID=

# Optional: OAuth client of type "Web application" with redirect https://<extension-id>.chromiumapp.org/
# Used when getAuthToken is unavailable (Chrome not signed in, Arc, Brave, ...).
VITE_GOOGLE_WEB_CLIENT_ID=

# Set to 1 to use the built-in demo calendar instead of Google (automatic when no client ID is set).
VITE_MOCK_CALENDAR=

# Local AI service. Must match the backend's AMEND_HOST/AMEND_PORT.
VITE_BACKEND_URL=http://127.0.0.1:47615

# How long the side panel waits for /analyze and /match (ms). Raise on slow CPU-only machines.
VITE_ANALYZE_TIMEOUT_MS=300000
VITE_MATCH_TIMEOUT_MS=180000
