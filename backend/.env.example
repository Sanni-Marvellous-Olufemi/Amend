# Copy to backend/.env (gitignored). scripts/gen-extension-key.sh fills in AMEND_EXTENSION_ID.

# Only this extension origin may call /analyze and /match. Empty = any chrome-extension:// origin (dev only).
AMEND_EXTENSION_ID=

AMEND_HOST=127.0.0.1
AMEND_PORT=47615

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct

# Seconds to wait for the model. A GPU/Apple Silicon answers in seconds; CPU-only machines
# can take 1-2 minutes per screenshot (the first call also loads the weights).
AMEND_TIMEOUT_S=240

# 1 = canned answers, no Ollama needed (for UI work and CI).
AMEND_MOCK=0
